# API-Key von https://newsdata.io (kostenlos registrieren)
NEWSDATA_API_KEY=pub_fa19f5c14ce145d0875391cf53bfbe5d

# MongoDB Connection String (Standard für docker-compose, nicht ändern wenn du Docker nutzt)
MONGO_URI=mongodb://mongo:27017/newsdb

# Port des Backend-Servers
PORT=3000

# Daily fetch configuration
# Daily keywords to backfill and update (comma-separated). Using focused German keywords to save quota.
DAILY_KEYWORDS=politik,wirtschaft,technik
# Run an initial fetch on server start
DAILY_RUN_ON_START=true
# Limit to German only
DAILY_LANGUAGES=de
# Fetcher limits: pages per keyword and delay between page requests (ms)
DAILY_MAX_PAGES=3
DAILY_RATE_DELAY_MS=1000

# NewsData daily credit planning
# Total credits available per day
NEWSDATA_DAILY_CREDITS=200
# Number of articles returned per credit (provider-specific)
NEWSDATA_ARTICLES_PER_CREDIT=10
# Number of runs per day (used to divide credits). Use DAILY_RUN_TIMES to set exact times.
DAILY_RUNS_PER_DAY=3
# Comma-separated times (HH:MM) for daily runs. Defaults to 08:00,13:00,20:00
DAILY_RUN_TIMES=08:00,13:00,20:00
# Optional: override pages per pair distribution if needed
# DAILY_MAX_PAGES is still used as fallback per pair

